# Midnight Application Environment Configuration
# DO NOT commit the actual .env.local with real keys or addresses to version control.

# The deployed Midnight Compact Contract Address
# To get this, deploy your contract manually and paste the generated address below.
# Replace `<YOUR_DEPLOYED_CONTRACT_ADDRESS>` with the actual string.
NEXT_PUBLIC_CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>

# The target Midnight network (e.g., 'local', 'testnet', 'preprod')
NEXT_PUBLIC_MIDNIGHT_NETWORK=local
