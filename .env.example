# Midnight Application Environment Configuration
# DO NOT commit the actual .env.local or .env with real keys or addresses to version control.

# The deployed Midnight Compact Contract Address
# To get this, deploy your contract manually and paste the generated address below.
# Replace `<YOUR_DEPLOYED_CONTRACT_ADDRESS>` with the actual string.
CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>

# Private state storage password (do not commit real passwords)
PRIVATE_STATE_PASSWORD=local-development-password-1
